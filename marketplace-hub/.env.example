PORT=4100
DATABASE_URL=postgresql://user:password@localhost:5432/marketplace_hub

# API integration is intentionally optional at this stage.
# KASPI_API_TOKEN=
# KASPI_BASE_URL=https://kaspi.kz
# KASPI_ALLOW_WRITES=false

# Catalog AI (optional; explicit source analysis works without this)
OPENAI_API_KEY=
OPENAI_ENRICHMENT_MODEL=gpt-6-luna

# Optional background cleanup / normalization
CATALOG_CLOUDINARY_CLOUD_NAME=
CATALOG_CLOUDINARY_API_KEY=
CATALOG_CLOUDINARY_API_SECRET=
CATALOG_IMAGE_CANVAS_SIZE=1200
CATALOG_IMAGE_CONTENT_SIZE=960
CATALOG_IMAGE_BACKGROUND=white

# Internal Catalog Hub API
# In production auth is required by default.
CATALOG_HUB_AUTH_REQUIRED=true
CATALOG_HUB_API_KEY=replace-with-long-random-secret
