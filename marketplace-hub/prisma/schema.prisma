generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MarketplaceCode {
  KASPI
  WILDBERRIES
  OZON
}

enum ListingStatus {
  DRAFT
  READY
  SUBMITTED
  MODERATION
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum SyncStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum ImportStatus {
  PREVIEW
  APPLIED
  FAILED
}

enum MediaStatus {
  ORIGINAL
  PROCESSED
  APPROVED
  REJECTED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts       MarketplaceAccount[]
  products       Product[]
  warehouses     Warehouse[]
  suppliers      Supplier[]
  pricingRules   PricingRule[]
}

model MarketplaceAccount {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  marketplace    MarketplaceCode
  externalId     String?
  displayName    String
  secretRef      String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  listings MarketplaceListing[]
  syncJobs SyncJob[]

  @@unique([organizationId, marketplace, externalId])
}

model Product {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sku            String
  barcode        String?
  title          String
  brand          String?
  description    String?
  categoryKey    String?
  attributes     Json?
  images         Json?
  purchasePrice  Int?
  basePrice      Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  listings       MarketplaceListing[]
  inventory      Inventory[]
  supplierLinks  SupplierProduct[]
  importRows     PriceImportRow[]
  media          ProductMedia[]

  @@unique([organizationId, sku])
  @@index([barcode])
}

model Supplier {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  importProfiles ImportProfile[]
  imports        PriceImport[]
  products       SupplierProduct[]
  documentImports DocumentImport[]

  @@unique([organizationId, code])
}

model SupplierProduct {
  id            String   @id @default(cuid())
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierSku   String?
  barcode       String?
  purchasePrice Int?
  lastStock     Int?
  lastSeenAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([supplierId, productId])
  @@unique([supplierId, supplierSku])
  @@index([barcode])
}

model ImportProfile {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name       String
  fileType   String
  delimiter  String?
  sheetName  String?
  mapping    Json
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([supplierId, name])
}

model PriceImport {
  id          String       @id @default(cuid())
  supplierId  String
  supplier    Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  filename    String
  sourceType  String
  status      ImportStatus @default(PREVIEW)
  rowCount    Int          @default(0)
  validRows   Int          @default(0)
  invalidRows Int          @default(0)
  appliedAt   DateTime?
  createdAt   DateTime     @default(now())

  rows PriceImportRow[]

  @@index([supplierId, createdAt])
}

model PriceImportRow {
  id            String      @id @default(cuid())
  importId      String
  import        PriceImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  rowNumber     Int
  productId     String?
  product       Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  supplierSku   String?
  barcode       String?
  title         String?
  purchasePrice Int?
  stock         Int?
  raw           Json
  errors        Json?
  createdAt     DateTime    @default(now())

  @@index([importId, rowNumber])
  @@index([supplierSku])
  @@index([barcode])
}

model PricingRule {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  priority        Int          @default(100)
  isActive        Boolean      @default(true)
  minPurchase     Int?
  maxPurchase     Int?
  markupPercent   Float?
  fixedMarkup     Int?
  roundingStep    Int          @default(10)
  marketplace     MarketplaceCode?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId, isActive, priority])
}

model MarketplaceListing {
  id                   String             @id @default(cuid())
  marketplaceAccountId String
  marketplaceAccount   MarketplaceAccount @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)
  productId            String
  product              Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  externalProductId    String?
  externalOfferId      String?
  externalCategoryId   String?
  sellerSku            String?
  titleOverride        String?
  descriptionOverride  String?
  attributesOverride   Json?
  price                Int?
  preorderDays         Int?
  status               ListingStatus      @default(DRAFT)
  lastError            String?
  lastSyncedAt         DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([marketplaceAccountId, productId])
  @@index([externalProductId])
  @@index([externalOfferId])
}

model Warehouse {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  inventory Inventory[]

  @@unique([organizationId, code])
}

model Inventory {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  onHand      Int       @default(0)
  reserved    Int       @default(0)
  safetyStock Int       @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([productId, warehouseId])
}

model SyncJob {
  id                   String             @id @default(cuid())
  marketplaceAccountId String
  marketplaceAccount   MarketplaceAccount @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)
  kind                 String
  status               SyncStatus         @default(PENDING)
  payload              Json?
  result               Json?
  error                String?
  attempts             Int                @default(0)
  createdAt            DateTime           @default(now())
  startedAt            DateTime?
  finishedAt           DateTime?

  @@index([status, createdAt])
}


model DocumentImport {
  id             String    @id @default(cuid())
  supplierId     String?
  supplier       Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  filename       String
  mimeType       String
  sizeBytes      Int
  pageCount      Int?
  textCharacters Int?
  ocrRecommended Boolean   @default(false)
  warnings       Json?
  metadata       Json?
  createdAt      DateTime  @default(now())

  @@index([supplierId, createdAt])
}

model ProductMedia {
  id             String      @id @default(cuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceType     String
  sourceUrl      String?
  originalFormat String?
  mimeType       String
  width          Int?
  height         Int?
  sizeBytes      Int?
  fileHash       String?
  isPrimary      Boolean     @default(false)
  status         MediaStatus @default(ORIGINAL)
  metadata       Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  variants MediaVariant[]

  @@index([productId, isPrimary])
  @@index([fileHash])
}

model MediaVariant {
  id        String       @id @default(cuid())
  mediaId   String
  media     ProductMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  preset    String
  format    String
  mimeType  String
  width     Int
  height    Int
  sizeBytes Int
  storageKey String?
  url       String?
  createdAt DateTime     @default(now())

  @@unique([mediaId, preset])
}
