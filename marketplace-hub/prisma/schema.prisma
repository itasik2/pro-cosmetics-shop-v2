generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MarketplaceCode {
  KASPI
  WILDBERRIES
  OZON
}

enum ListingStatus {
  DRAFT
  READY
  SUBMITTED
  MODERATION
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum SyncStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum ImportStatus {
  PREVIEW
  APPLIED
  FAILED
}

enum MediaStatus {
  ORIGINAL
  PROCESSED
  APPROVED
  REJECTED
}

enum CatalogEnrichmentJobStatus {
  PENDING
  RUNNING
  REVIEW
  APPLIED
  FAILED
  CANCELED
}

enum CatalogEnrichmentProposalStatus {
  PENDING
  APPLIED
  REJECTED
}

enum ChangeSetStatus {
  PREVIEW
  APPROVED
  PARTIALLY_APPLIED
  APPLIED
  REJECTED
}

enum FieldChangeStatus {
  PROPOSED
  APPROVED
  APPLIED
  REJECTED
}

enum ChangeSetSourceType {
  IMPORT
  AI_ENRICHMENT
  MANUAL
  SYSTEM
}

enum FieldChangeRisk {
  LOW
  MEDIUM
  HIGH
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts       MarketplaceAccount[]
  products       Product[]
  warehouses     Warehouse[]
  suppliers      Supplier[]
  pricingRules   PricingRule[]
  changeSets     CatalogChangeSet[]
  mediaProfiles  MediaProfile[]
}

model MarketplaceAccount {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  marketplace    MarketplaceCode
  externalId     String?
  displayName    String
  secretRef      String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  listings MarketplaceListing[]
  syncJobs SyncJob[]

  @@unique([organizationId, marketplace, externalId])
}

model Product {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sku            String
  barcode        String?
  title          String
  brand          String?
  shortDescription String?
  description      String?
  application      String?
  ingredients      String?
  categoryKey    String?
  attributes     Json?
  images         Json?
  purchasePrice  Int?
  basePrice      Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  listings       MarketplaceListing[]
  inventory      Inventory[]
  supplierLinks  SupplierProduct[]
  importRows     PriceImportRow[]
  media               ProductMedia[]
  sourceSnapshots     ProductSourceSnapshot[]
  enrichmentJobs      CatalogEnrichmentJob[]
  enrichmentProposals CatalogEnrichmentProposal[]
  changeSets          CatalogChangeSet[]
  revisions           ProductRevision[]

  @@unique([organizationId, sku])
  @@index([barcode])
}

model Supplier {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  importProfiles ImportProfile[]
  imports        PriceImport[]
  products       SupplierProduct[]
  documentImports DocumentImport[]
  sourcePolicies  CatalogSourcePolicy[]

  @@unique([organizationId, code])
}

model SupplierProduct {
  id            String   @id @default(cuid())
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierSku   String?
  barcode       String?
  purchasePrice Int?
  lastStock     Int?
  lastSeenAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([supplierId, productId])
  @@unique([supplierId, supplierSku])
  @@index([barcode])
}

model ImportProfile {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name       String
  fileType   String
  delimiter  String?
  sheetName  String?
  mapping    Json
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([supplierId, name])
}

model PriceImport {
  id          String       @id @default(cuid())
  supplierId  String
  supplier    Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  filename    String
  sourceType  String
  status      ImportStatus @default(PREVIEW)
  rowCount    Int          @default(0)
  validRows   Int          @default(0)
  invalidRows Int          @default(0)
  appliedAt   DateTime?
  createdAt   DateTime     @default(now())

  rows PriceImportRow[]

  @@index([supplierId, createdAt])
}

model PriceImportRow {
  id            String      @id @default(cuid())
  importId      String
  import        PriceImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  rowNumber     Int
  productId     String?
  product       Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  supplierSku   String?
  barcode       String?
  title         String?
  purchasePrice Int?
  stock         Int?
  raw           Json
  errors        Json?
  createdAt     DateTime    @default(now())

  @@index([importId, rowNumber])
  @@index([supplierSku])
  @@index([barcode])
}

model PricingRule {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  priority        Int          @default(100)
  isActive        Boolean      @default(true)
  minPurchase     Int?
  maxPurchase     Int?
  markupPercent   Float?
  fixedMarkup     Int?
  roundingStep    Int          @default(10)
  marketplace     MarketplaceCode?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId, isActive, priority])
}

model MarketplaceListing {
  id                   String             @id @default(cuid())
  marketplaceAccountId String
  marketplaceAccount   MarketplaceAccount @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)
  productId            String
  product              Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  externalProductId    String?
  externalOfferId      String?
  externalCategoryId   String?
  sellerSku            String?
  titleOverride        String?
  descriptionOverride  String?
  attributesOverride   Json?
  price                Int?
  preorderDays         Int?
  status               ListingStatus      @default(DRAFT)
  lastError            String?
  lastSyncedAt         DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([marketplaceAccountId, productId])
  @@index([externalProductId])
  @@index([externalOfferId])
}

model Warehouse {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  inventory Inventory[]

  @@unique([organizationId, code])
}

model Inventory {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  onHand      Int       @default(0)
  reserved    Int       @default(0)
  safetyStock Int       @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([productId, warehouseId])
}

model SyncJob {
  id                   String             @id @default(cuid())
  marketplaceAccountId String
  marketplaceAccount   MarketplaceAccount @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)
  kind                 String
  status               SyncStatus         @default(PENDING)
  payload              Json?
  result               Json?
  error                String?
  attempts             Int                @default(0)
  createdAt            DateTime           @default(now())
  startedAt            DateTime?
  finishedAt           DateTime?

  @@index([status, createdAt])
}


model DocumentImport {
  id             String    @id @default(cuid())
  supplierId     String?
  supplier       Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  filename       String
  mimeType       String
  sizeBytes      Int
  pageCount      Int?
  textCharacters Int?
  ocrRecommended Boolean   @default(false)
  warnings       Json?
  metadata       Json?
  createdAt      DateTime  @default(now())

  @@index([supplierId, createdAt])
}

model MediaProfile {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code             String
  name             String
  target           String?
  width            Int
  height           Int
  mode             String       @default("BOUND")
  format           String       @default("webp")
  quality          Int          @default(86)
  background       String       @default("#ffffff")
  allowUpscale     Boolean      @default(false)
  removeBackground Boolean      @default(false)
  trim             Boolean      @default(false)
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, isActive, target])
}

model ProductMedia {
  id             String      @id @default(cuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceType     String
  sourceUrl      String?
  originalFormat String?
  mimeType       String
  width          Int?
  height         Int?
  sizeBytes      Int?
  fileHash       String?
  isPrimary      Boolean     @default(false)
  status         MediaStatus @default(ORIGINAL)
  metadata       Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  variants MediaVariant[]

  @@index([productId, isPrimary])
  @@index([fileHash])
}

model MediaVariant {
  id        String       @id @default(cuid())
  mediaId   String
  media     ProductMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  preset    String
  format    String
  mimeType  String
  width     Int
  height    Int
  sizeBytes Int
  storageKey String?
  url       String?
  createdAt DateTime     @default(now())

  @@unique([mediaId, preset])
}


model CatalogSourcePolicy {
  id              String   @id @default(cuid())
  supplierId      String
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name            String
  domain          String
  baseUrl         String?
  sourceType      String   @default("OFFICIAL_SITE")
  allowSubdomains Boolean  @default(true)
  isEnabled       Boolean  @default(true)
  priority        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  snapshots ProductSourceSnapshot[]

  @@unique([supplierId, domain])
  @@index([supplierId, isEnabled, priority])
}

model ProductSourceSnapshot {
  id             String               @id @default(cuid())
  productId      String
  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourcePolicyId String?
  sourcePolicy   CatalogSourcePolicy? @relation(fields: [sourcePolicyId], references: [id], onDelete: SetNull)
  url            String
  canonicalUrl   String?
  title          String?
  sourceType     String
  contentHash    String?
  httpStatus     Int?
  rawData        Json?
  extractedData  Json?
  lastCheckedAt  DateTime             @default(now())
  lastChangedAt  DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  proposals CatalogEnrichmentProposal[]

  @@unique([productId, url])
  @@index([productId, lastCheckedAt])
}

model CatalogEnrichmentJob {
  id         String                     @id @default(cuid())
  productId  String
  product    Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  status     CatalogEnrichmentJobStatus @default(PENDING)
  sourceUrl  String?
  result     Json?
  error      String?
  attempt    Int                        @default(0)
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt
  startedAt  DateTime?
  finishedAt DateTime?

  proposals CatalogEnrichmentProposal[]

  @@index([productId, status, createdAt])
}

model CatalogEnrichmentProposal {
  id               String                          @id @default(cuid())
  productId        String
  product          Product                         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceId         String?
  source           ProductSourceSnapshot?          @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  jobId            String?
  job              CatalogEnrichmentJob?           @relation(fields: [jobId], references: [id], onDelete: SetNull)
  sourceUrl        String
  confidence       Int
  title            String?
  shortDescription String?
  description      String?
  application      String?
  ingredients      String?
  images           Json?
  facts            Json?
  warnings         Json?
  evaluation       Json?
  status           CatalogEnrichmentProposalStatus @default(PENDING)
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt
  appliedAt        DateTime?

  @@index([productId, status, createdAt])
  @@index([confidence])
}


model CatalogChangeSet {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  sku            String
  sourceType     ChangeSetSourceType
  sourceRef      String?
  status         ChangeSetStatus     @default(PREVIEW)
  current        Json
  proposed       Json
  summary        Json
  approvedFields Json?
  appliedFields  Json?
  rejectedFields Json?
  createdBy      String?
  approvedBy     String?
  appliedBy      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  approvedAt     DateTime?
  appliedAt      DateTime?
  rejectedAt     DateTime?

  fields    CatalogFieldChange[]
  revisions ProductRevision[]

  @@index([organizationId, status, createdAt])
  @@index([productId, createdAt])
  @@index([sku, createdAt])
  @@index([sourceType, sourceRef])
}

model CatalogFieldChange {
  id          String            @id @default(cuid())
  changeSetId String
  changeSet   CatalogChangeSet  @relation(fields: [changeSetId], references: [id], onDelete: Cascade)
  field       String
  risk        FieldChangeRisk
  beforeValue Json?
  afterValue  Json?
  status      FieldChangeStatus @default(PROPOSED)
  approvedBy  String?
  appliedBy   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  approvedAt  DateTime?
  appliedAt   DateTime?
  rejectedAt  DateTime?

  @@unique([changeSetId, field])
  @@index([status, risk])
}

model ProductRevision {
  id          String            @id @default(cuid())
  productId   String
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  changeSetId String?
  changeSet   CatalogChangeSet? @relation(fields: [changeSetId], references: [id], onDelete: SetNull)
  reason      String
  snapshot    Json
  createdBy   String?
  createdAt   DateTime          @default(now())

  @@index([productId, createdAt])
  @@index([changeSetId])
}
