{
  "name": "marketplace-hub",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server-offline.ts",
    "dev:api": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server-offline.js",
    "start:api": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^6.19.1",
    "fast-xml-parser": "^5.2.5",
    "fastify": "^5.6.1",
    "xlsx": "^0.18.5",
    "yaml": "^2.8.1",
    "zod": "^3.23.8",
    "pdfjs-dist": "4.10.38",
    "sharp": "^0.35.5",
    "cheerio": "1.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.23",
    "prisma": "^6.19.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2"
  }
}
