# Database
# Runtime/serverless traffic uses the pooled Neon connection.
DATABASE_URL="postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"
# Prisma migrations must use the direct Neon endpoint without "-pooler".
# The migration script also accepts DATABASE_URL_UNPOOLED or POSTGRES_URL_NON_POOLING.
DIRECT_URL="postgresql://USER:PASSWORD@ENDPOINT.REGION.aws.neon.tech/DATABASE?sslmode=require"

# NextAuth / admin
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-at-least-32-random-characters"
AUTH_ADMIN_EMAIL="admin@example.com"
AUTH_ADMIN_PASSWORD="replace-with-a-long-unique-admin-password"
# Dedicated HMAC secret for customer order links. Required in production.
ORDER_ACCESS_SECRET="replace-with-at-least-32-random-characters"

# Optional scoped secrets for shared multi-tenant runtime (fallback to non-scoped vars)
# For SITE_KEY=procosmetics -> suffix PROCOSMETICS
# AUTH_ADMIN_EMAIL_PROCOSMETICS="admin@procosmetics.kz"
# AUTH_ADMIN_PASSWORD_PROCOSMETICS="..."
# ORDER_ACCESS_SECRET_PROCOSMETICS="..."
# ADMIN_EMAIL_PROCOSMETICS="sales@procosmetics.kz"
# SMTP_HOST_PROCOSMETICS="smtp.zoho.com"
# SMTP_PORT_PROCOSMETICS="465"
# SMTP_SECURE_PROCOSMETICS="true"
# SMTP_USER_PROCOSMETICS="sales@procosmetics.kz"
# SMTP_PASSWORD_PROCOSMETICS="zoho-app-password"
# EMAIL_FROM_PROCOSMETICS="procosmetics.kz <sales@procosmetics.kz>"
# Optional fallback if SMTP is not configured
# RESEND_API_KEY_PROCOSMETICS="re_..."

# Site config
# Multi-site mode: deploy same codebase with different SITE_KEY and branding
# SITE_KEY examples: procosmetics | fitoapteka
SITE_KEY="procosmetics"
SITE_TITLE="Pro Cosmetics — магазин профессиональной косметики"
SITE_DESCRIPTION="Профессиональная косметика и уходовые средства с доставкой по Казахстану."
NEXT_PUBLIC_SITE_BRAND="procosmetics.kz"
NEXT_PUBLIC_CONTACT_EMAIL="sales@procosmetics.kz"

# Guest checkout payment instructions (public business details only)
# Fill these in Vercel before accepting Kaspi-transfer orders.
PAYMENT_RECIPIENT_NAME=""
KASPI_PAYMENT_PHONE=""
KASPI_PAYMENT_LINK=""
KASPI_PAYMENT_QR_IMAGE_URL=""
PAYMENT_INSTRUCTIONS=""
SITE_NICHE_LABEL="профессиональная косметика"
SITE_HERO_TITLE="Профессиональная косметика для ухода, которая подходит именно вашей коже."
SITE_HERO_SUBTITLE="Подбирайте средства по типу и потребностям кожи. В каждой карточке — назначение, способ применения и понятные рекомендации."
SITE_ABOUT_SUMMARY="магазин профессиональной косметики для продуманного домашнего ухода. Мы отбираем средства под конкретные задачи кожи и подробно объясняем, как ими пользоваться."
SITE_ABOUT_GOAL="Наша цель — помочь выстроить понятный уход за кожей: от базового очищения и увлажнения до восстановления, антивозрастного ухода и средств для проблемной кожи."
# Включить публичный блок отзывов после появления регистрации покупателей
PUBLIC_REVIEWS_ENABLED="false"

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Product photos: AI background removal -> trim -> centered square canvas.
# Set to false only if you temporarily need to disable AI normalization.
PRODUCT_IMAGE_NORMALIZATION_ENABLED="true"
PRODUCT_IMAGE_CANVAS_SIZE="1200"
PRODUCT_IMAGE_CONTENT_SIZE="960"
PRODUCT_IMAGE_BACKGROUND="white"

# Analytics
UMAMI_WEBSITE_ID=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_PUBLIC_KEY=""

# OpenAI
OPENAI_API_KEY=""

# Telegram notifications (use scoped *_PROCOSMETICS variants in multi-site deployments)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET="replace-with-at-least-32-random-characters"
TELEGRAM_LINK_SECRET="replace-with-at-least-32-random-characters"

# Halyk ePay. Set mode=production only with real credentials.
HALYK_EPAY_MODE="test"
HALYK_EPAY_CLIENT_ID=""
HALYK_EPAY_CLIENT_SECRET=""
HALYK_EPAY_TERMINAL_ID=""
HALYK_EPAY_CALLBACK_SECRET="replace-with-at-least-32-random-characters"

# QazPost Open Post API (official portal: https://open.post.kz/)
QAZPOST_API_BASE_URL="https://open.post.kz"
QAZPOST_API_TOKEN=""

# Safe catalog autopilot
# Vercel Cron sends: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="replace-with-at-least-32-random-characters"
CATALOG_AUTOPILOT_ENABLED="true"
CATALOG_AUTOPILOT_MIN_CONFIDENCE="90"
CATALOG_AUTOPILOT_PROPOSAL_BATCH="8"
CATALOG_AUTOPILOT_DISCOVERY_BATCH="1"
CATALOG_AUTOPILOT_MONITOR_BATCH="4"
ENRICHMENT_MONITOR_STALE_HOURS="168"

# Daily network popularity monitor (only existing published catalog products)
CATALOG_POPULARITY_MONITOR_ENABLED="true"
CATALOG_POPULARITY_MONITOR_BATCH="8"
CATALOG_POPULARITY_AUTO_SLOTS="8"
CATALOG_POPULARITY_MIN_SCORE="65"
CATALOG_POPULARITY_STALE_DAYS="14"
# Verified public seller and delivery terms; scoped _PROCOSMETICS keys are supported.
# Leave unconfirmed details empty. An empty delivery price is NOT free delivery.
STORE_SELLER_NAME=""
STORE_SELLER_ID=""
STORE_SELLER_ADDRESS=""
STORE_DELIVERY_PRICE=""
STORE_DELIVERY_TERMS=""
STORE_RETURNS_TERMS=""
# AI store consultant: server-side only. Empty model uses gpt-5.6-luna (also used by catalog enrichment).
OPENAI_ASK_MODEL=
AI_CONSULTANT_ENABLED=true
# Total model calls per site/day; default 200. Also 5 requests/minute and 30 calls/day per IP.
AI_CONSULTANT_DAILY_LIMIT=200


# Catalog Hub shadow integration (read-only)
# Supports scoped *_PROCOSMETICS variables through getScopedEnv.
CATALOG_HUB_SHADOW_ENABLED="false"
CATALOG_HUB_URL="https://catalog-hub.example.com"
CATALOG_HUB_API_KEY=""
CATALOG_HUB_ORGANIZATION_ID=""
CATALOG_HUB_WAREHOUSE_ID=""
CATALOG_HUB_WRITE_ENABLED="false"
CATALOG_HUB_READ_ENABLED="false"
CATALOG_HUB_READ_STRICT="false"
CATALOG_HUB_TIMEOUT_MS="5000"
