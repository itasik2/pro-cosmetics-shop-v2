generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Supplier {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  siteUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
  imports  PriceImport[]
  sources  SupplierSource[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique

  brandId     String?
  brand       Brand?   @relation(fields: [brandId], references: [id])

  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierSku String?
  barcode     String?

  shortDescription String?
  description      String
  price       Int
  sourcePrice Int?
  image       String
  category    String
  stock       Int      @default(0)

  volumeValue     Int?
  volumeUnit      String?
  productLineCode String?
  productLineName String?
  priceListDate   DateTime?
  lastImportedAt  DateTime?

  isPopular   Boolean  @default(false)
  popularityPinned Boolean @default(false)
  popularityExcluded Boolean @default(false)
  popularityScore Int @default(0)
  popularityConfidence Int @default(0)
  popularityReason String?
  popularityEvidence Json?
  popularityCheckedAt DateTime?
  isNew       Boolean  @default(false)
  isPublished Boolean  @default(true)

  enrichmentStatus     String @default("READY")
  sourceUrl             String?
  descriptionSourceUrl  String?
  imageSourceUrl        String?

  variants    Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  importRows          PriceImportRow[]
  priceHistory       ProductPriceHistory[]
  sources            ProductSource[]
  images             ProductImage[]
  enrichmentJobs     EnrichmentJob[]
  enrichmentProposals ProductEnrichmentProposal[]

  @@unique([supplierId, supplierSku])
  @@index([isPublished, isPopular, popularityPinned, popularityScore], map: "Product_popularity_rank_idx")
}

enum ProductSourceStatus {
  ACTIVE
  UNAVAILABLE
  BLOCKED
  ERROR
}

enum EnrichmentJobStatus {
  PENDING
  RUNNING
  REVIEW
  APPLIED
  FAILED
  CANCELED
}

enum EnrichmentProposalStatus {
  PENDING
  APPLIED
  REJECTED
}

model SupplierSource {
  id              String   @id @default(cuid())
  supplierId      String
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name            String
  domain          String
  baseUrl         String
  sourceType      String   @default("OFFICIAL_SITE")
  isEnabled       Boolean  @default(true)
  allowSubdomains Boolean  @default(true)
  priority        Int      @default(0)
  selectors       Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  productSources ProductSource[]

  @@unique([supplierId, domain])
  @@index([supplierId, isEnabled, priority])
}

model ProductSource {
  id               String              @id @default(cuid())
  productId        String
  product          Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierSourceId String?
  supplierSource   SupplierSource?     @relation(fields: [supplierSourceId], references: [id], onDelete: SetNull)
  url              String
  canonicalUrl     String?
  sourceType       String              @default("OFFICIAL_SITE")
  title            String?
  contentHash      String?
  lastCheckedAt    DateTime?
  lastChangedAt    DateTime?
  status           ProductSourceStatus @default(ACTIVE)
  httpStatus       Int?
  rawData          Json?
  extractedData    Json?
  error             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  proposals ProductEnrichmentProposal[]

  @@unique([productId, url])
  @@index([supplierSourceId, status])
  @@index([productId, lastCheckedAt])
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  sourceUrl    String?
  sourceDomain String?
  checksum     String?
  width        Int?
  height       Int?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@unique([productId, url])
  @@index([productId, isPrimary])
  @@index([checksum])
}

model EnrichmentJob {
  id           String              @id @default(cuid())
  productId    String
  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  status       EnrichmentJobStatus @default(PENDING)
  attempt      Int                 @default(0)
  maxAttempts  Int                 @default(3)
  scheduledAt  DateTime            @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  sourceUrl    String?
  error        String?
  result       Json?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  proposal ProductEnrichmentProposal?

  @@index([status, scheduledAt])
  @@index([productId, createdAt])
}

model ProductEnrichmentProposal {
  id               String                       @id @default(cuid())
  productId        String
  product          Product                      @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceId         String?
  source           ProductSource?               @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  jobId            String?                      @unique
  job              EnrichmentJob?               @relation(fields: [jobId], references: [id], onDelete: SetNull)
  status           EnrichmentProposalStatus     @default(PENDING)
  sourceUrl         String
  confidence       Int                          @default(0)
  title            String?
  shortDescription String?
  description      String?
  application      String?
  ingredients      String?
  images           Json?
  facts             Json?
  warnings          Json?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  appliedAt         DateTime?

  @@index([productId, status, createdAt])
  @@index([sourceId])
}

enum PriceImportStatus {
  UPLOADED
  PARSING
  REVIEW
  APPLIED
  FAILED
}

enum ImportRowAction {
  CREATE
  UPDATE
  SKIP
  ERROR
  MANUAL_REVIEW
}

model PriceImport {
  id          String            @id @default(cuid())
  supplierId  String
  supplier    Supplier          @relation(fields: [supplierId], references: [id])

  fileName    String
  fileHash    String
  sourceDate  DateTime?
  status      PriceImportStatus @default(UPLOADED)

  priceMode      String @default("PRICE_AS_IS")
  markupPercent Int    @default(0)
  roundingStep  Int    @default(100)

  totalRows   Int @default(0)
  validRows   Int @default(0)
  createdRows Int @default(0)
  updatedRows Int @default(0)
  skippedRows Int @default(0)
  errorRows   Int @default(0)

  createdAt   DateTime @default(now())
  appliedAt   DateTime?

  rows         PriceImportRow[]
  priceHistory ProductPriceHistory[]

  @@unique([supplierId, fileHash])
}

model PriceImportRow {
  id          String          @id @default(cuid())
  importId    String
  import      PriceImport     @relation(fields: [importId], references: [id], onDelete: Cascade)

  rowNumber   Int
  pageNumber  Int?
  rawData     Json
  parsedData  Json?

  supplierSku String?
  productId   String?
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  action      ImportRowAction @default(MANUAL_REVIEW)
  confidence  Int             @default(0)
  selected    Boolean         @default(true)
  error       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([importId, action])
  @@index([productId])
}

model ProductPriceHistory {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  importId    String?
  import      PriceImport? @relation(fields: [importId], references: [id], onDelete: SetNull)

  oldPrice    Int?
  newPrice    Int
  sourcePrice Int?
  createdAt   DateTime @default(now())

  @@index([productId, createdAt])
  @@index([importId])
}

enum OrderStatus {
  NEW
  CONFIRMED
  PACKING
  SHIPPED
  DONE
  CANCELED
}

enum PaymentMethod {
  CASH
  KASPI_TRANSFER
}

enum PaymentStatus {
  UNPAID
  DUE_ON_DELIVERY
  PENDING
  PAID
  REFUNDED
}

model Order {
  id           String      @id @default(cuid())
  orderNumber  String      @unique
  customerName String
  phone        String
  email        String?
  notificationChannel String?
  notificationContact String?
  deliveryType String
  address      String?
  comment      String?
  currency     String      @default("KZT")
  totalAmount  Int
  status          OrderStatus   @default(NEW)
  paymentMethod  PaymentMethod @default(CASH)
  paymentStatus  PaymentStatus @default(UNPAID)
  paidAt         DateTime?
  notificationStatus    String   @default("PENDING")
  notificationAttempts  Int      @default(0)
  notificationLastError String?
  notificationSentAt    DateTime?
  customerNotificationStatus    String   @default("SKIPPED")
  customerNotificationAttempts  Int      @default(0)
  customerNotificationLastError String?
  customerNotificationSentAt    DateTime?
  customerAccessTokenHash       String?   @unique
  confirmedAt                   DateTime?
  paymentDueAt                  DateTime?
  paymentReportedAt             DateTime?
  paymentReportedNote           String?
  paymentNotificationStatus     String    @default("SKIPPED")
  paymentNotificationAttempts   Int       @default(0)
  paymentNotificationLastError  String?
  paymentNotificationSentAt     DateTime?
  archivedAt                    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        OrderItem[]

  @@index([notificationStatus, createdAt], map: "Order_notification_status_created_idx")
  @@index([paymentDueAt, paymentMethod, paymentStatus], map: "Order_payment_due_idx")
  @@index([paymentNotificationStatus, createdAt], map: "Order_payment_notification_idx")
  @@index([archivedAt, createdAt], map: "Order_archived_created_idx")
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  variantId    String?
  title        String
  unitPrice    Int
  qty          Int
  lineTotal    Int
  image        String?
  sku          String?
  createdAt    DateTime @default(now())
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  role      String   @default("user")
  createdAt DateTime @default(now())
}

model Post {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  content         String
  category        String
  image           String?
  imageCredit     String?
  imageSourceUrl  String?
  imageLicense    String?
  imageLicenseUrl String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SiteSettings {
  id           String   @id @default("default")
  siteName     String   @default("pro.cosmetics")
  heroTitle    String   @default("Профессиональная косметика для ухода за кожей")
  heroSubtitle String   @default("Подбираем эффективные средства для домашнего ухода.")
  heroImage    String?  @default("/seed/serum.jpg")
  footerText   String   @default("Интернет-магазин профессиональной косметики")
  phone        String?  @default("+7")
  email        String?  @default("sales@vita-services.com")
  updatedAt    DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  name      String
  text      String
  rating    Int      @default(5)
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ThemeSettings {
  id              String   @id @default("default")
  themeProfile    String   @default("neutral")
  scheduleEnabled Boolean  @default(false)
  scheduleStart   DateTime?
  scheduleEnd     DateTime?
  backgroundUrl   String   @default("")
  bannerEnabled   Boolean  @default(false)
  bannerText      String   @default("")
  bannerHref      String?
  updatedAt       DateTime @updatedAt
}

model ExternalLink {
  id        String   @id @default(cuid())
  siteKey   String
  kind      String
  label     String
  url       String   @default("")
  isEnabled Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteKey, sortOrder], map: "ExternalLink_site_order_idx")
}

model SiteHealthCheck {
  id             String   @id @default(cuid())
  siteKey        String
  isHealthy      Boolean
  responseTimeMs Int?
  checks         Json
  error          String?
  createdAt      DateTime @default(now())

  @@index([siteKey, createdAt], map: "SiteHealthCheck_site_created_idx")
  @@index([siteKey, isHealthy, createdAt], map: "SiteHealthCheck_site_health_created_idx")
}
