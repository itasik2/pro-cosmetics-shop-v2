generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Supplier {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  siteUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
  imports  PriceImport[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique

  brandId     String?
  brand       Brand?   @relation(fields: [brandId], references: [id])

  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierSku String?
  barcode     String?

  description String
  price       Int
  sourcePrice Int?
  image       String
  category    String
  stock       Int      @default(0)

  volumeValue     Int?
  volumeUnit      String?
  productLineCode String?
  productLineName String?
  priceListDate   DateTime?
  lastImportedAt  DateTime?

  isPopular   Boolean  @default(false)
  isNew       Boolean  @default(false)
  isPublished Boolean  @default(true)

  enrichmentStatus    String @default("READY")
  sourceUrl            String?
  descriptionSourceUrl String?
  imageSourceUrl        String?

  variants    Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  importRows   PriceImportRow[]
  priceHistory ProductPriceHistory[]

  @@unique([supplierId, supplierSku])
}

enum PriceImportStatus {
  UPLOADED
  PARSING
  REVIEW
  APPLIED
  FAILED
}

enum ImportRowAction {
  CREATE
  UPDATE
  SKIP
  ERROR
  MANUAL_REVIEW
}

model PriceImport {
  id          String            @id @default(cuid())
  supplierId  String
  supplier    Supplier          @relation(fields: [supplierId], references: [id])

  fileName    String
  fileHash    String
  sourceDate  DateTime?
  status      PriceImportStatus @default(UPLOADED)

  priceMode      String @default("PRICE_AS_IS")
  markupPercent Int    @default(0)
  roundingStep  Int    @default(100)

  totalRows   Int @default(0)
  validRows   Int @default(0)
  createdRows Int @default(0)
  updatedRows Int @default(0)
  skippedRows Int @default(0)
  errorRows   Int @default(0)

  createdAt   DateTime @default(now())
  appliedAt   DateTime?

  rows         PriceImportRow[]
  priceHistory ProductPriceHistory[]

  @@unique([supplierId, fileHash])
}

model PriceImportRow {
  id          String          @id @default(cuid())
  importId    String
  import      PriceImport     @relation(fields: [importId], references: [id], onDelete: Cascade)

  rowNumber   Int
  pageNumber  Int?
  rawData     Json
  parsedData  Json?

  supplierSku String?
  productId   String?
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  action      ImportRowAction @default(MANUAL_REVIEW)
  confidence  Int             @default(0)
  selected    Boolean         @default(true)
  error       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([importId, action])
  @@index([productId])
}

model ProductPriceHistory {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  importId    String?
  import      PriceImport? @relation(fields: [importId], references: [id], onDelete: SetNull)

  oldPrice    Int?
  newPrice    Int
  sourcePrice Int?
  createdAt   DateTime @default(now())

  @@index([productId, createdAt])
  @@index([importId])
}

enum OrderStatus {
  NEW
  CONFIRMED
  PACKING
  SHIPPED
  DONE
  CANCELED
}

model Order {
  id           String      @id @default(cuid())

  // Публичный номер (для клиента/админки)
  orderNumber  String      @unique

  customerName String
  phone        String
  email        String?
  deliveryType String      // "pickup" | "delivery" (MVP строкой, чтобы не ломать миграции)
  address      String?
  comment      String?

  currency     String      @default("KZT")
  totalAmount  Int

  status       OrderStatus @default(NEW)

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  items        OrderItem[]
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId    String
  variantId    String?  // если base — null

  title        String   // snapshot названия (и варианта)
  unitPrice    Int      // snapshot цены (тенге)
  qty          Int
  lineTotal    Int

  image        String?
  sku          String?

  createdAt    DateTime @default(now())
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  role      String   @default("user")
  createdAt DateTime @default(now())
}

model Post {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  category  String
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id           String   @id @default("default")
  siteName     String   @default("pro.cosmetics")
  heroTitle    String   @default("Профессиональная косметика для ухода за кожей")
  heroSubtitle String   @default("Подбираем эффективные средства для домашнего ухода.")
  heroImage    String?  @default("/seed/serum.jpg")
  footerText   String   @default("Интернет-магазин профессиональной косметики")
  phone        String?  @default("+7")
  email        String?  @default("sales@vita-services.com")
  updatedAt    DateTime @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  name      String
  text      String
  rating    Int      @default(5)
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ThemeSettings {
  id              String   @id @default("default")

  // Включение по расписанию (UTC)
  scheduleEnabled Boolean  @default(false)
  scheduleStart   DateTime?
  scheduleEnd     DateTime?

  // Фон сайта
  backgroundUrl   String   @default("")

  // Баннер
  bannerEnabled   Boolean  @default(false)
  bannerText      String   @default("")
  bannerHref      String?

  updatedAt       DateTime @updatedAt
}
