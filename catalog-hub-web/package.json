{
  "name": "catalog-hub-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test lib/*.test.ts lib/official-search/*.test.ts",
    "local:init": "node scripts/local-init.mjs",
    "local:check": "node scripts/local-check.mjs",
    "local:dev": "node scripts/local-dev.mjs",
    "local:keygen": "node scripts/local-keygen.mjs",
    "testdb:setup": "node ../catalog-hub-local/setup.mjs",
    "testdb:use": "node ../catalog-hub-local/switch.mjs test",
    "testdb:remote": "node ../catalog-hub-local/switch.mjs remote",
    "testdb:stop": "docker compose -f ../catalog-hub-local/compose.yaml down",
    "testdb:status": "docker compose -f ../catalog-hub-local/compose.yaml ps",
    "testdb:import-e2e": "node ../catalog-hub-local/import-e2e.mjs"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "fast-xml-parser": "^5.2.5",
    "next": "15.5.24",
    "pdfjs-dist": "4.10.38",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "read-excel-file": "^9.3.10",
    "undici": "^7.30.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.19.23",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "tsx": "^4.20.3",
    "typescript": "^5.6.2"
  }
}
